# --- App ---
APP_ENV=development                # development | test | production
APP_SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_sales_agent
DATABASE_URL_TEST=postgresql+asyncpg://user:password@localhost:5432/ai_sales_agent_test

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- LLM ---
# LLM_LOCAL=true  → local Ollama at OLLAMA_BASE_URL
# LLM_LOCAL=false → use LLM_REMOTE_URL (e.g. Cloudflare tunnel to remote Ollama)
LLM_LOCAL=true
LLM_MODEL=qwen3:14b
LLM_REMOTE_URL=https://reproduction-comp-labeled-learners.trycloudflare.com
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_MAX_CONCURRENT_REQUESTS=4
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_SELF_HOSTED_OVERRIDE_ALLOWED=true

# --- LLM: Groq (optional, per-org key stored encrypted in DB, this is only a platform-level feature flag) ---
GROQ_ENABLED=true
GROQ_TIMEOUT_SECONDS=15

# --- Encryption for stored API credentials ---
CREDENTIAL_ENCRYPTION_KEY=changeme-generate-with-fernet-key

# --- Business Discovery ---
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_CACHE_TTL_DAYS=7
GOOGLE_PLACES_ENABLED=false        # true only with a key below (your key / free trial)
GOOGLE_PLACES_API_KEY=             # optional enrichment for reviews/rating/phone

# --- Website Audit ---
WEBSITE_FETCH_TIMEOUT_SECONDS=10
WEBSITE_FETCH_MAX_BYTES=5242880    # 5MB
WEBSITE_RECRAWL_TTL_DAYS=30

# --- Email (ESP) ---
ESP_PROVIDER=console               # console (FREE, default) | resend | smtp | postmark | ses
ESP_API_KEY=changeme
ESP_PLATFORM_SENDING_ROOT_DOMAIN=mail.yourplatform.com   # orgs without a custom verified domain get an isolated subdomain of this
ESP_DAILY_SEND_CAP_PER_ORG=100
ESP_WEEKLY_SEND_CAP_PER_ORG=500
ESP_BOUNCE_RATE_PAUSE_THRESHOLD=0.05
ESP_COMPLAINT_RATE_PAUSE_THRESHOLD=0.001
ESP_FROM_EMAIL=noreply@localhost
ESP_FROM_NAME=Outreach
PUBLIC_APP_URL=http://localhost:8000
# SMTP (optional — use with ESP_PROVIDER=smtp, e.g. Mailhog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# --- Billing ---
STRIPE_SECRET_KEY=changeme
STRIPE_WEBHOOK_SECRET=changeme
STRIPE_PRICE_ID_STARTER=changeme
STRIPE_PRICE_ID_PRO=changeme
TRIAL_LENGTH_DAYS=14

# --- Observability ---
LOG_LEVEL=INFO
SENTRY_DSN=

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173


# --- Rate limits ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_API_PER_MIN=120

# --- Production secrets (generate; never commit real values) ---
# APP_SECRET_KEY=$(openssl rand -hex 32)
# CREDENTIAL_ENCRYPTION_KEY=$(python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# APP_ENV=production
# PUBLIC_APP_URL=https://api.yourdomain.com
# ALLOWED_ORIGINS=https://app.yourdomain.com

# Platform super-admins (comma-separated emails)
PLATFORM_ADMIN_EMAILS=
DEMO_MODE=true
